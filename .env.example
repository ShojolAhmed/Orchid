# Copy to .env.local (git-ignored) and fill in.
#
# Everything prefixed VITE_ is bundled into the browser build and visible to anyone who opens the
# site. Only public values belong here. NEVER add a Spotify client secret: PKCE needs none, and
# anything put in a VITE_ variable would be published.

# Client ID from the Spotify Developer Dashboard (your app > Settings). Public by design.
VITE_SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered for the app, including scheme, host, port and path.
# Spotify allows HTTPS, or HTTP on an explicit loopback IP such as 127.0.0.1. "localhost" is not allowed.
# The path must be /callback. Open the app at this same origin (npm run dev serves 127.0.0.1:5173).
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional. The name other Spotify apps show for this browser in their device list (Spotify Connect).
# Defaults to "Orchid Web Player".
# VITE_SPOTIFY_DEVICE_NAME=Orchid Web Player
